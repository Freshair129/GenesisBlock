# Cargo
target/
Cargo.lock

# napi-rs build artifacts (per-platform .node files are CI-built and
# distributed via per-triple optional-deps packages — not committed)
*.node
npm-debug.log
# Audit/bench/test run logs (e.g. ga_b3_full.log) — never commit run logs
*.log
dashboard/playwright-report/
dashboard/test-results/
dashboard/dist/
studio/dist/
studio/node_modules/
studio/playwright-report/
studio/test-results/
studio/src-tauri/gen/
studio/src-tauri/target-verify/
studio/src-tauri/icons/android/
studio/src-tauri/icons/ios/
studio/src-tauri/icons/StoreLogo.png
studio/src-tauri/icons/Square*Logo.png

# Auto-generated index.js / index.d.ts are committed (P3.1) so callers
# can require('@freshair129/gks-genesis-block-native') even before a
# local `napi build`. P3.2+ may regenerate via `napi build` — keep both
# files in sync with src/lib.rs manually until then.

/benches/snb/temp_db_bulk/
/benches/snb/data/
/target/


/benches/scientific_audit_db/

# Data/WAL
**/*.wal
**/*.lock
# ...but track the root Cargo.lock for reproducible binary/addon builds
!/Cargo.lock
# The Studio desktop shell is an independent Cargo package and ships its lockfile.
!studio/src-tauri/Cargo.lock
**/*.bin
.brain/
**/temp_db/
**/temp_db_bulk/
benches/*_db/

# Test scratch DBs — generated AND consumed within each `cargo test` run
# (every test does remove_dir_all first; not committed fixtures)
tests/test_*/

# Independent Benchmark Suite run outputs — generated locally, attached to
# issues manually (see BENCHMARKING.md §8). Keep the directory, ignore the runs.
/benchmark/results/*
!/benchmark/results/.gitkeep
# Generated real-embedding corpora for the moat bench (tens of MB, rebuildable
# from the repo by benchmark/gen_corpus_bge_m3.py). The .manifest.json IS
# tracked: it is the provenance record (model, dim, count, sha256, commit) that
# a reported real-corpus number must be reproducible from.
/benchmark/fixtures/*.f32

# Python bytecode cache
__pycache__/
*.pyc

# Local doc/audit export artifacts (generated, not source)
docs/audit.zip

# stray doc archives in repo root
/docs.zip
