+        let mut visible_current_count = 0usize;
+        let mut metadata_samples = Vec::new();
+        let mut missing_node_samples = Vec::new();
+
+        for row in metadata.iter() {
+            let retired = row.retired_seq != 0;
+            if retired {
+                retired_count += 1;
+            }
+            let node = self.nodes.get(&row.node_u32);
+            let node_id = node.as_ref().map(|node| node.value().id.clone());
+            let visible = node
+                .as_ref()
+                .map(|node| Self::is_node_visible(node.value(), &None, false, &now))
+                .unwrap_or(false);
+            if !retired && visible {
+                visible_current_count += 1;
+            }
+            if node.is_none() {
+                missing_node_count += 1;
+                if !retired {
+                    missing_current_node_count += 1;
+                }
+                if missing_node_samples.len() < sample_limit {
+                    missing_node_samples.push(serde_json::json!({
+                        "arena_id": row.arena_id,
+                        "node_u32": row.node_u32,
+                        "retired_seq": row.retired_seq,
+                    }));
+                }
+            }
+            if metadata_samples.len() < sample_limit {
+                metadata_samples.push(serde_json::json!({
+                    "arena_id": row.arena_id,
+                    "node_u32": row.node_u32,
+                    "node_id": node_id,
+                    "retired_seq": row.retired_seq,
+                    "visible_current": !retired && visible,
+                }));
+            }
+        }
+
+        let summary = serde_json::json!({
+            "event": "metadata_summary",
+            "collection": coll.name.clone(),
+            "metadata_count": metadata.len(),
+            "node_count": self.nodes.len(),
+            "retired_count": retired_count,
+            "missing_node_count": missing_node_count,
+            "missing_current_node_count": missing_current_node_count,
+            "visible_current_count": visible_current_count,
+            "metadata_samples": metadata_samples,
+            "missing_node_samples": missing_node_samples,
+        });
+        eprintln!("GB_VECTOR_QUERY_DIAG {summary}");
+        Ok(summary)
+    }
