+    pub fn diagnostic_vector_metadata_summary(
+        &self,
+        name: &str,
+        sample_limit: usize,
+    ) -> Result<Value> {
+        self.ensure_readable()?;
+        let _read_guard = self.commit_lock.lock();
+        let coll = self.resolve_collection(&Some(name.to_string()))?;
+        let metadata = coll.metadata.read();
