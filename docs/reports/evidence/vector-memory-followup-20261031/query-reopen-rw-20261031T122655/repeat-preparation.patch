+#[cfg(windows)]
+#[repr(C)]
+#[derive(Default, Clone, Copy)]
+struct WinFileTime {
+    low: u32,
+    high: u32,
+}
+
+#[cfg(windows)]
+impl WinFileTime {
+    fn as_u64(self) -> u64 {
+        ((self.high as u64) << 32) | self.low as u64
