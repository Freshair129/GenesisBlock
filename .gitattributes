# The mobile C ABI header is generated by cbindgen and verified byte-for-byte
# against fresh output in CI (mobile-build.yml "C header freshness"). Pin LF so a
# CRLF checkout on a Windows dev box can't make that gate spuriously fail.
include/genesisdb.h text eol=lf

# Benchmark shell scripts must stay LF — a CRLF checkout breaks bash on
# Linux/macOS/CI (`\r` in the shebang / line endings). The .ps1 siblings are
# Windows-only and unaffected.
benchmark/*.sh text eol=lf

# The vendored copies of the iOS Swift SDK sources are generated by
# scripts/vendor-rn-ios-sdk.mjs and verified byte-for-byte in CI
# (mobile-build.yml "rn-ios-vendor-freshness"). Same reason as the header
# above: pin LF so a CRLF checkout on the Windows dev box can't fail the gate.
react-native-genesisdb/ios/vendor/*.swift text eol=lf

# Same reason as benchmark/*.sh above: these run on Linux/macOS CI runners, and
# a CRLF checkout on the Windows dev box breaks bash (`\r` in the shebang and
# at every line end). scripts/rn-host-fixture.sh is executed by the RN host
# acceptance workflow.
scripts/*.sh text eol=lf

# The one committed native addon (see npm/linux-x64-gnu/README.md). Git's
# auto-detection would almost certainly classify a stripped ELF as binary
# anyway, but "almost certainly" is not a guarantee worth taking on a 9.5 MiB
# artifact that a Docker image stage copies verbatim — one CRLF substitution
# inside it and it stops loading, with nothing in the diff to show why.
*.node binary
