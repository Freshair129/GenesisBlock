WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
identifier = @{ (ASCII_ALPHANUMERIC | "_" | "-")+ }
string_lit = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
fuzzy_prefix = { "~" }
target = { fuzzy_prefix? ~ (identifier | string_lit) }
seed = { fuzzy_prefix? ~ (identifier | string_lit) }

rel_type = { identifier }
infer_rel = { ^"INFER" ~ "(" ~ identifier ~ ")" }
rel = { infer_rel | rel_type }

number = @{ ("+" | "-")? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
vector = { number ~ ("," ~ number)* }
// Digit rules MUST be atomic (@): a non-atomic `{ ASCII_DIGIT+ }` lets pest's
// implicit WHITESPACE creep into the matched span (e.g. "2 "), which then fails
// `.parse()` and silently falls back to the default — this was the long-standing
// "DEPTH always parses to 1" bug. See ADR--GENESISDB-HQL-FILTER-PROJECTION.
k = @{ ASCII_DIGIT+ }
depth = @{ ASCII_DIGIT+ }
alpha = { number }
lang_spec = { ^"LANGUAGE" ~ string_lit }
as_of = { ^"AS" ~ ^"OF" ~ string_lit }
collection_spec = { ^"IN" ~ (identifier | string_lit) }

// --- filter / projection / ergonomics clauses (ADR--GENESISDB-HQL-FILTER-PROJECTION) ---
// All four are optional and post-process the command's result list in order:
// WHERE -> ORDER BY -> LIMIT -> RETURN. prop.<key> reaches into a node's `props`.
prop_field = @{ ^"prop." ~ (ASCII_ALPHANUMERIC | "_" | "-")+ }
field = { prop_field | ^"id" | ^"label" | ^"score" | ^"depth" }
op = { "<=" | ">=" | "!=" | "=" | "<" | ">" | ^"CONTAINS" | ^"STARTSWITH" }
filter_value = { string_lit | number }
predicate = { field ~ op ~ filter_value }
where_clause = { ^"WHERE" ~ predicate ~ (^"AND" ~ predicate)* }
order_dir = { ^"ASC" | ^"DESC" }
order_clause = { ^"ORDER" ~ ^"BY" ~ field ~ order_dir? }
limit_n = @{ ASCII_DIGIT+ }
limit_clause = { ^"LIMIT" ~ limit_n }
return_all = { "*" }
return_clause = { ^"RETURN" ~ (return_all | field ~ ("," ~ field)*) }
// Whole group is nullable, so existing clause-free queries still parse unchanged.
clauses = { where_clause? ~ order_clause? ~ limit_clause? ~ return_clause? }

search = { ^"SEARCH" ~ target ~ ^"SIMILAR" ~ ^"TO" ~ "[" ~ vector ~ "]" ~ ^"K" ~ k ~ collection_spec? ~ lang_spec? ~ as_of? ~ clauses }
traverse = { ^"TRAVERSE" ~ ^"FROM" ~ seed ~ ^"DEPTH" ~ depth ~ ^"REL" ~ rel ~ as_of? ~ clauses }
hybrid = { ^"MATCH" ~ target ~ ^"SIMILAR" ~ ^"TO" ~ "[" ~ vector ~ "]" ~ ^"ALPHA" ~ alpha ~ collection_spec? ~ lang_spec? ~ as_of? ~ clauses }

// --- Cypher-style graph pattern matching (ADR--GENESISDB-HQL-CYPHER-PATTERNS, path 1) ---
// A linear path pattern: an anchor node followed by zero+ (edge, node) hops.
// `MATCH (` routes here; `MATCH <ident> SIMILAR` falls through to `hybrid` below
// (a hybrid target never starts with "("), so the two MATCH forms never collide.
pat_var = { identifier }
pat_label = { ":" ~ identifier }
prop_pair = { identifier ~ ":" ~ filter_value }
pat_props = { "{" ~ prop_pair ~ ("," ~ prop_pair)* ~ "}" }
node_pattern = { "(" ~ pat_var? ~ pat_label? ~ pat_props? ~ ")" }
// rel_detail carries the optional edge variable + optional `:Type`. Direction is
// encoded by the surrounding dashes/arrows. Order matters: try the arrow forms
// before the bare `-...-` (both-direction) form.
rel_detail = { "[" ~ pat_var? ~ pat_label? ~ "]" }
edge_in = { "<-" ~ rel_detail? ~ "-" }
edge_out = { "-" ~ rel_detail? ~ "->" }
edge_both = { "-" ~ rel_detail? ~ "-" }
edge_pattern = { edge_in | edge_out | edge_both }
hop = { edge_pattern ~ node_pattern }
graph_pattern = { node_pattern ~ hop* }
// Variable-qualified clause fields: `a` (whole bound entity) | `a.id` | `a.label`
// | `a.prop.<key>`. Distinct from the unqualified `field` used by the other
// commands' `clauses`, so pattern rows can address multiple variables.
qual_tail = { prop_field | ^"id" | ^"label" }
qual_field = { identifier ~ ("." ~ qual_tail)? }
pat_predicate = { qual_field ~ op ~ filter_value }
pat_where = { ^"WHERE" ~ pat_predicate ~ (^"AND" ~ pat_predicate)* }
pat_order = { ^"ORDER" ~ ^"BY" ~ qual_field ~ order_dir? }
pat_return = { ^"RETURN" ~ (return_all | qual_field ~ ("," ~ qual_field)*) }
pat_clauses = { pat_where? ~ pat_order? ~ limit_clause? ~ pat_return? }
match_pattern = { ^"MATCH" ~ graph_pattern ~ as_of? ~ pat_clauses }

budget = @{ ASCII_DIGIT+ }
tier = { "H0" | "H1" | "H2" | "H3" | "H4" | "H5" | "H6" }
context = { ^"CONTEXT" ~ ^"FOR" ~ target ~ ^"TIER" ~ tier ~ (^"BUDGET" ~ budget)? }

// `match_pattern` MUST precede `hybrid`: both start with MATCH, and ordered-choice
// tries the pattern form first (fails fast when there is no "(", backtracking to
// the hybrid form) — see ADR--GENESISDB-HQL-CYPHER-PATTERNS.
query = { SOI ~ (search | traverse | match_pattern | hybrid | context) ~ EOI }
