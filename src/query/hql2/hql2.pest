// Production PEG port of the pinned Blueprint hql2.lark. Syntax acceptance is
// distinct from execution support. Keyword atoms enforce identifier boundaries.
WHITESPACE = _{ " " | "\t" | "\r" | "\n" | "\u{000C}" }
COMMENT = _{ "//" ~ (!("\r" | "\n") ~ ANY)* }
start = { SOI ~ statement ~ ";"? ~ EOI }
statement = _{ explain | query | ddl | mutate | transaction | apply_batch | admin }
explain = { k_explain ~ k_analyze? ~ query }
query = { scope? ~ query_body }
scope = { k_use ~ name ~ tx_selector? ~ valid_selector? }
tx_selector = { k_at ~ k_tx ~ unsigned }
valid_selector = { k_at ~ k_valid ~ string }
query_body = { source ~ ("|>" ~ stage)* ~ "|>" ~ return_stage }
source = _{ node_source | edge_source | row_source | ann_source | match_source | history_source | changes_source | values_source | union_source }
node_source = { k_from ~ k_nodes ~ (name ~ &k_as)? ~ k_as ~ name }
edge_source = { k_from ~ k_edges ~ (name ~ &k_as)? ~ k_as ~ name }
row_source = { k_from ~ k_table ~ name ~ k_as ~ name }
ann_source = { k_from ~ k_annotations ~ k_as ~ name }
match_source = { k_match ~ k_shortest? ~ pattern ~ (k_as ~ name)? ~ path_mode? }
history_source = { k_history ~ history_kind ~ id_value ~ k_as ~ name }
changes_source = { k_changes ~ k_since ~ unsigned ~ k_as ~ name }
values_source = { k_values ~ parameter ~ k_as ~ name }
union_source = { k_union ~ k_all ~ "{" ~ query_body ~ "}" ~ "{" ~ query_body ~ "}" }
stage = _{ filter_stage | knn_stage | lexical_stage | expand_stage | ann_stage | join_stage | project_stage | distinct_stage | group_stage | aggregate_stage | order_stage | take_stage | skip_stage | pack_stage | rerank_stage }
filter_stage = { k_filter ~ expr }
knn_stage = { k_knn ~ name ~ k_in ~ name ~ k_using ~ expr ~ k_top ~ unsigned ~ mode ~ k_as ~ name }
mode = { k_exact | k_approx }
lexical_stage = { k_lexical ~ name ~ k_field ~ name ~ k_query ~ expr ~ k_using ~ k_index ~ name ~ k_top ~ unsigned ~ k_as ~ name }
expand_stage = { k_optional? ~ k_expand ~ pattern ~ (k_as ~ name)? ~ path_mode? }
ann_stage = { k_optional? ~ k_annotations ~ k_of ~ name ~ k_as ~ name }
join_stage = { join_kind? ~ k_join ~ k_table ~ name ~ k_as ~ name ~ k_on ~ expr }
join_kind = { k_inner | k_left | k_semi | k_anti }
project_stage = { k_project ~ select_list }
distinct_stage = { k_distinct }
group_stage = { k_group ~ k_by ~ select_list ~ k_agg ~ select_list }
aggregate_stage = { k_agg ~ select_list }
order_stage = { k_order ~ k_by ~ order_item ~ ("," ~ order_item)* }
order_item = { expr ~ sort_direction? ~ null_order? }
sort_direction = { k_asc | k_desc }
null_order = { k_nulls ~ (k_first | k_last) }
take_stage = { k_take ~ unsigned }
skip_stage = { k_skip ~ unsigned }
pack_stage = { k_pack ~ k_context ~ k_text ~ expr ~ k_evidence ~ expr ~ k_tokens ~ unsigned ~ k_tokenizer ~ string ~ k_as ~ name }
rerank_stage = { k_rerank ~ name ~ k_in ~ name ~ k_using ~ expr ~ k_top ~ unsigned ~ k_exact ~ k_as ~ name }
return_stage = { k_return ~ select_list }
select_list = { select_item ~ ("," ~ select_item)* }
select_item = { star | expr ~ (k_as ~ name)? }
star = { "*" }
pattern = { node_pattern ~ (edge_pattern ~ node_pattern)* }
node_pattern = { "(" ~ name? ~ (":" ~ name)? ~ object? ~ ")" }
edge_pattern = { "-" ~ edge_detail? ~ "->" | "<-" ~ edge_detail? ~ "-" | "-" ~ edge_detail? ~ "-" }
edge_detail = { "[" ~ name? ~ (":" ~ relation_list)? ~ object? ~ hop_range? ~ "]" }
relation_list = { name ~ ("|" ~ name)* }
hop_range = { "*" ~ uint ~ ".." ~ uint }
path_mode = { k_trail | k_simple | k_walk }
ddl = _{ create_type | create_table | create_collection | create_index | drop_index }
create_type = { k_create ~ (k_node | k_edge | k_annotation) ~ k_type ~ name ~ k_schema ~ parameter }
create_table = { k_create ~ k_table ~ name ~ k_schema ~ parameter }
create_collection = { k_create ~ k_collection ~ name ~ k_dim ~ uint ~ k_metric ~ metric ~ k_model ~ string ~ k_quant ~ quant }
metric = { k_cosine | k_l2_squared | k_neg_dot }
quant = { k_f32 | k_f16 | k_sq8 | k_bq }
create_index = { k_create ~ k_unique? ~ k_index ~ name ~ k_on ~ index_target ~ ("(" ~ name ~ ("," ~ name)* ~ ")")? ~ k_using ~ index_method ~ (k_include ~ "(" ~ name ~ ("," ~ name)* ~ ")")? ~ (k_where ~ expr)? ~ (k_with ~ parameter)? }
index_target = { k_node ~ name | k_edge ~ name | k_table ~ name | k_annotation | k_collection ~ name }
index_method = { k_btree | k_hnsw | k_inverted }
drop_index = { k_drop ~ k_index ~ name }
mutate = _{ upsert_node | upsert_edge | upsert_row | upsert_vector | annotate | retract }
upsert_node = { k_upsert ~ k_node ~ id_value ~ k_labels ~ array ~ k_props ~ value ~ valid_window? }
upsert_edge = { k_upsert ~ k_edge ~ id_value ~ k_from ~ id_value ~ k_to ~ id_value ~ k_type ~ string ~ k_props ~ value ~ valid_window? }
upsert_row = { k_upsert ~ k_row ~ name ~ k_key ~ value ~ k_values ~ value ~ valid_window? }
upsert_vector = { k_upsert ~ k_vector ~ k_on ~ k_node ~ id_value ~ k_in ~ name ~ k_using ~ value ~ valid_window? }
annotate = { k_annotate ~ kind ~ id_value ~ k_with ~ parameter }
retract = { k_retract ~ kind ~ id_value ~ (k_expect ~ k_revision ~ id_value)? }
valid_window = { k_valid ~ k_from ~ value ~ k_to ~ value }
kind = { k_node | k_edge | k_row | k_annotation | k_artifact }
history_kind = { k_node | k_edge | k_row | k_vector | k_annotation | k_artifact }
transaction = { k_transaction ~ k_id ~ id_value ~ "{" ~ (mutate ~ ";")+ ~ "}" }
apply_batch = { k_apply ~ parameter }
admin = { k_show ~ show_kind | k_rebuild ~ k_index ~ name | k_analyze ~ k_index ~ name | k_check ~ k_database | k_checkpoint | k_compact }
show_kind = { k_capabilities | k_indexes | k_collections | k_schemas }
expr = { or_expr }
or_expr = { and_expr ~ (or_op ~ and_expr)* }
or_op = { k_or }
and_expr = { not_expr ~ (and_op ~ not_expr)* }
and_op = { k_and }
not_expr = { not_op* ~ comparison }
not_op = { k_not }
comparison = { sum_expr ~ (comp_op ~ sum_expr | is_null | in_array | between)? }
is_null = { k_is ~ k_not? ~ k_null }
in_array = { k_not? ~ k_in ~ array }
between = { k_between ~ sum_expr ~ k_and ~ sum_expr }
comp_op = { "!=" | "<>" | "<=" | ">=" | "=" | "<" | ">" | k_contains | k_startswith }
sum_expr = { term ~ (sum_op ~ term)* }
sum_op = { "+" | "-" }
term = { atom ~ (mul_op ~ atom)* }
mul_op = { "*" | "/" | "%" }
atom = _{ function | field_ref | literal | group }
group = { "(" ~ expr ~ ")" }
function = { name ~ "(" ~ function_args? ~ ")" }
function_args = { star | expr ~ ("," ~ expr)* }
field_ref = { name ~ ("." ~ name)+ | !(k_true | k_false | k_null) ~ name }
value = _{ parameter | string | number | boolean | null | array | object }
literal = _{ parameter | string | number | boolean | null | array | object }
boolean = { k_true | k_false }
null = { k_null }
array = { "[" ~ (expr ~ ("," ~ expr)*)? ~ "]" }
object = { "{" ~ (pair ~ ("," ~ pair)*)? ~ "}" }
pair = { (name | string) ~ ":" ~ expr }
id_value = { string | parameter }
unsigned = { uint | parameter }
parameter = @{ "$" ~ cname }
name = @{ cname | quoted_name }
cname = { (ASCII_ALPHA | "_") ~ ident_continue* }
ident_continue = _{ ASCII_ALPHANUMERIC | "_" }
quoted_name = { "`" ~ (!("`" | "\r" | "\n") ~ ANY)+ ~ "`" }
string = @{ "\"" ~ ("\\" ~ ANY | !("\"" | "\\" | "\r" | "\n") ~ ANY)* ~ "\"" }
uint = @{ ("0" | ASCII_NONZERO_DIGIT ~ ASCII_DIGIT*) ~ !ident_continue }
number = @{ ("+" | "-")? ~ (ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)? | "." ~ ASCII_DIGIT+) ~ (^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+)? ~ !ident_continue }

k_agg = @{ ^"AGG" ~ !ident_continue }
k_all = @{ ^"ALL" ~ !ident_continue }
k_analyze = @{ ^"ANALYZE" ~ !ident_continue }
k_and = @{ ^"AND" ~ !ident_continue }
k_annotate = @{ ^"ANNOTATE" ~ !ident_continue }
k_annotation = @{ ^"ANNOTATION" ~ !ident_continue }
k_annotations = @{ ^"ANNOTATIONS" ~ !ident_continue }
k_anti = @{ ^"ANTI" ~ !ident_continue }
k_apply = @{ ^"APPLY" ~ !ident_continue }
k_approx = @{ ^"APPROX" ~ !ident_continue }
k_artifact = @{ ^"ARTIFACT" ~ !ident_continue }
k_as = @{ ^"AS" ~ !ident_continue }
k_asc = @{ ^"ASC" ~ !ident_continue }
k_at = @{ ^"AT" ~ !ident_continue }
k_between = @{ ^"BETWEEN" ~ !ident_continue }
k_bq = @{ ^"BQ" ~ !ident_continue }
k_btree = @{ ^"BTREE" ~ !ident_continue }
k_by = @{ ^"BY" ~ !ident_continue }
k_capabilities = @{ ^"CAPABILITIES" ~ !ident_continue }
k_changes = @{ ^"CHANGES" ~ !ident_continue }
k_check = @{ ^"CHECK" ~ !ident_continue }
k_checkpoint = @{ ^"CHECKPOINT" ~ !ident_continue }
k_collection = @{ ^"COLLECTION" ~ !ident_continue }
k_collections = @{ ^"COLLECTIONS" ~ !ident_continue }
k_compact = @{ ^"COMPACT" ~ !ident_continue }
k_contains = @{ ^"CONTAINS" ~ !ident_continue }
k_context = @{ ^"CONTEXT" ~ !ident_continue }
k_cosine = @{ ^"COSINE" ~ !ident_continue }
k_create = @{ ^"CREATE" ~ !ident_continue }
k_database = @{ ^"DATABASE" ~ !ident_continue }
k_desc = @{ ^"DESC" ~ !ident_continue }
k_dim = @{ ^"DIM" ~ !ident_continue }
k_distinct = @{ ^"DISTINCT" ~ !ident_continue }
k_drop = @{ ^"DROP" ~ !ident_continue }
k_edge = @{ ^"EDGE" ~ !ident_continue }
k_edges = @{ ^"EDGES" ~ !ident_continue }
k_evidence = @{ ^"EVIDENCE" ~ !ident_continue }
k_exact = @{ ^"EXACT" ~ !ident_continue }
k_expand = @{ ^"EXPAND" ~ !ident_continue }
k_expect = @{ ^"EXPECT" ~ !ident_continue }
k_explain = @{ ^"EXPLAIN" ~ !ident_continue }
k_f16 = @{ ^"F16" ~ !ident_continue }
k_f32 = @{ ^"F32" ~ !ident_continue }
k_false = @{ ^"FALSE" ~ !ident_continue }
k_field = @{ ^"FIELD" ~ !ident_continue }
k_filter = @{ ^"FILTER" ~ !ident_continue }
k_first = @{ ^"FIRST" ~ !ident_continue }
k_from = @{ ^"FROM" ~ !ident_continue }
k_group = @{ ^"GROUP" ~ !ident_continue }
k_history = @{ ^"HISTORY" ~ !ident_continue }
k_hnsw = @{ ^"HNSW" ~ !ident_continue }
k_id = @{ ^"ID" ~ !ident_continue }
k_in = @{ ^"IN" ~ !ident_continue }
k_include = @{ ^"INCLUDE" ~ !ident_continue }
k_index = @{ ^"INDEX" ~ !ident_continue }
k_indexes = @{ ^"INDEXES" ~ !ident_continue }
k_inner = @{ ^"INNER" ~ !ident_continue }
k_inverted = @{ ^"INVERTED" ~ !ident_continue }
k_is = @{ ^"IS" ~ !ident_continue }
k_join = @{ ^"JOIN" ~ !ident_continue }
k_key = @{ ^"KEY" ~ !ident_continue }
k_knn = @{ ^"KNN" ~ !ident_continue }
k_l2_squared = @{ ^"L2_SQUARED" ~ !ident_continue }
k_labels = @{ ^"LABELS" ~ !ident_continue }
k_last = @{ ^"LAST" ~ !ident_continue }
k_left = @{ ^"LEFT" ~ !ident_continue }
k_lexical = @{ ^"LEXICAL" ~ !ident_continue }
k_match = @{ ^"MATCH" ~ !ident_continue }
k_metric = @{ ^"METRIC" ~ !ident_continue }
k_model = @{ ^"MODEL" ~ !ident_continue }
k_neg_dot = @{ ^"NEG_DOT" ~ !ident_continue }
k_node = @{ ^"NODE" ~ !ident_continue }
k_nodes = @{ ^"NODES" ~ !ident_continue }
k_not = @{ ^"NOT" ~ !ident_continue }
k_null = @{ ^"NULL" ~ !ident_continue }
k_nulls = @{ ^"NULLS" ~ !ident_continue }
k_of = @{ ^"OF" ~ !ident_continue }
k_on = @{ ^"ON" ~ !ident_continue }
k_optional = @{ ^"OPTIONAL" ~ !ident_continue }
k_or = @{ ^"OR" ~ !ident_continue }
k_order = @{ ^"ORDER" ~ !ident_continue }
k_pack = @{ ^"PACK" ~ !ident_continue }
k_project = @{ ^"PROJECT" ~ !ident_continue }
k_props = @{ ^"PROPS" ~ !ident_continue }
k_quant = @{ ^"QUANT" ~ !ident_continue }
k_query = @{ ^"QUERY" ~ !ident_continue }
k_rebuild = @{ ^"REBUILD" ~ !ident_continue }
k_rerank = @{ ^"RERANK" ~ !ident_continue }
k_retract = @{ ^"RETRACT" ~ !ident_continue }
k_return = @{ ^"RETURN" ~ !ident_continue }
k_revision = @{ ^"REVISION" ~ !ident_continue }
k_row = @{ ^"ROW" ~ !ident_continue }
k_schema = @{ ^"SCHEMA" ~ !ident_continue }
k_schemas = @{ ^"SCHEMAS" ~ !ident_continue }
k_semi = @{ ^"SEMI" ~ !ident_continue }
k_shortest = @{ ^"SHORTEST" ~ !ident_continue }
k_show = @{ ^"SHOW" ~ !ident_continue }
k_simple = @{ ^"SIMPLE" ~ !ident_continue }
k_since = @{ ^"SINCE" ~ !ident_continue }
k_skip = @{ ^"SKIP" ~ !ident_continue }
k_sq8 = @{ ^"SQ8" ~ !ident_continue }
k_startswith = @{ ^"STARTSWITH" ~ !ident_continue }
k_table = @{ ^"TABLE" ~ !ident_continue }
k_take = @{ ^"TAKE" ~ !ident_continue }
k_text = @{ ^"TEXT" ~ !ident_continue }
k_to = @{ ^"TO" ~ !ident_continue }
k_tokenizer = @{ ^"TOKENIZER" ~ !ident_continue }
k_tokens = @{ ^"TOKENS" ~ !ident_continue }
k_top = @{ ^"TOP" ~ !ident_continue }
k_trail = @{ ^"TRAIL" ~ !ident_continue }
k_transaction = @{ ^"TRANSACTION" ~ !ident_continue }
k_true = @{ ^"TRUE" ~ !ident_continue }
k_tx = @{ ^"TX" ~ !ident_continue }
k_type = @{ ^"TYPE" ~ !ident_continue }
k_union = @{ ^"UNION" ~ !ident_continue }
k_unique = @{ ^"UNIQUE" ~ !ident_continue }
k_upsert = @{ ^"UPSERT" ~ !ident_continue }
k_use = @{ ^"USE" ~ !ident_continue }
k_using = @{ ^"USING" ~ !ident_continue }
k_valid = @{ ^"VALID" ~ !ident_continue }
k_values = @{ ^"VALUES" ~ !ident_continue }
k_vector = @{ ^"VECTOR" ~ !ident_continue }
k_walk = @{ ^"WALK" ~ !ident_continue }
k_where = @{ ^"WHERE" ~ !ident_continue }
k_with = @{ ^"WITH" ~ !ident_continue }
